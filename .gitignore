__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
venv/
.DS_Store
.vscode/
.idea/
# Secrets never belong here — this repository is public — but the ignore lines
# exist so a stray local file cannot be staged by accident.
.env
*.pem
secrets*

# Tracked before this rule existed, and an ignore rule untracks nothing —
# `git rm --cached` did that on 2026-09-13. `_ignored_but_tracked` now reports
# the general case, because the same sequence is how a .env gets published.
*.pyc
